{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noUncheckedIndexedAccess": true,
        "allowImportingTsExtensions": true,
        "noImplicitAny": true
    },
    "include": ["src"]
}
